# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Claude a usar (opcional, este es el valor por defecto)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Modelo de embeddings local (opcional, este es el valor por defecto)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
